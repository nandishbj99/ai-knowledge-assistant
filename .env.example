# =============================================================================
# AI Knowledge Assistant Environment Configuration Template
# Copy this file to .env and configure keys
# =============================================================================

# Primary AI Provider: Google AI Studio (Free Tier: https://aistudio.google.com/)
GEMINI_API_KEY=AIzaSy_YOUR_FREE_GEMINI_API_KEY_HERE
DEFAULT_EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004
LLM_MODEL=gemini-2.5-flash
VISION_MODEL=gemini-2.5-flash

# Optional: Ingestion Strategy ("standard" or "colpali")
INGESTION_STRATEGY=standard

# Optional: Secondary Provider (OpenAI fallback if desired)
OPENAI_API_KEY=

# Database (PostgreSQL 16 + pgvector)
POSTGRES_DB=knowledge_assistant
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Services Ports
AI_SERVICE_PORT=8001
BACKEND_PORT=8080

# Security (JWT Secret Key)
APP_JWT_SECRET=9a78bf234c90de45f871234098bc1234567890abcdef1234567890abcdef
