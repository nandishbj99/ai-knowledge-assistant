# Normalize line endings to LF in the repo, checkout as-is on all platforms
* text=auto eol=lf

# Explicitly LF for source files
*.java    text eol=lf
*.py      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.sql     text eol=lf
*.md      text eol=lf
*.lua     text eol=lf
*.json    text eol=lf
*.xml     text eol=lf
*.sh      text eol=lf
*.env     text eol=lf
*.txt     text eol=lf
*.toml    text eol=lf
Dockerfile text eol=lf
.gitignore text eol=lf

# Binary files — no line-ending conversion
*.jar     binary
*.class   binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.pdf     binary
*.zip     binary
*.gz      binary
*.tar     binary
